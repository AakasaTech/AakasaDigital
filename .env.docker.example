# ─────────────────────────────────────────────────────────────────────────────
# Aakasa Digital — Docker environment variables
#
# Copy this file to .env and fill in all values before running docker compose.
#   cp .env.docker.example .env
#
# Variables prefixed AAKASA_       → injected into the aakasa-digital container
# Variables prefixed BILLCRAFT_    → injected into the billcraft container
# Variables prefixed SUPPORTCRAFT_ → injected into the supportcraft container
# Variables prefixed TASKCRAFT_    → injected into the taskcraft container
# Variables prefixed PDFCRAFT_     → injected into the pdfcraft container
# Variables prefixed MEETINGCRAFT_ → injected into the meetingcraft + meetingcraft-worker containers
#
# NEXT_PUBLIC_* variables are build-time args — they are baked into the JS
# bundle during `docker compose build`. Changing them requires a rebuild.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# Aakasa Digital (marketing site)
# ═════════════════════════════════════════════════════════════════════════════

# Resend — used by the contact form to deliver messages to hello@aakasa.dev
# Get from: https://resend.com/api-keys
AAKASA_RESEND_API_KEY=re_...


# ═════════════════════════════════════════════════════════════════════════════
# BillCraft AI
# Docs: https://billcraft.aakasa.dev
# ═════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project → Settings → API
BILLCRAFT_SUPABASE_URL=https://<project-ref>.supabase.co
BILLCRAFT_SUPABASE_ANON_KEY=
BILLCRAFT_SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
BILLCRAFT_APP_URL=https://billcraft.aakasa.dev
# Comma-separated hostnames allowed to call this app's API (CORS) — baked in at build time
BILLCRAFT_ALLOWED_ORIGINS=billcraft.aakasa.dev,taskcraft.aakasa.dev,supportcraft.aakasa.dev,localhost:3000,localhost:3001,localhost:3002,localhost:3003

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
BILLCRAFT_OPENAI_API_KEY=sk-...

# ── Resend (transactional email) ──────────────────────────────────────────────
# Get from: https://resend.com/api-keys
BILLCRAFT_RESEND_API_KEY=re_...
BILLCRAFT_RESEND_FROM_EMAIL=invoices@aakasa.dev
BILLCRAFT_RESEND_FROM_NAME=BillCraft AI
BILLCRAFT_EMAIL_PROVIDER=resend

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API keys
BILLCRAFT_STRIPE_PUBLISHABLE_KEY=pk_live_...
BILLCRAFT_STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com → Developers → Webhooks
BILLCRAFT_STRIPE_WEBHOOK_SECRET=whsec_...
# Create in: Stripe Dashboard → Products → Prices
BILLCRAFT_STRIPE_BASIC_MONTHLY_PRICE_ID=price_...
BILLCRAFT_STRIPE_BASIC_ANNUAL_PRICE_ID=price_...
BILLCRAFT_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
BILLCRAFT_STRIPE_PRO_ANNUAL_PRICE_ID=price_...
BILLCRAFT_STRIPE_AGENCY_MONTHLY_PRICE_ID=price_...
BILLCRAFT_STRIPE_AGENCY_ANNUAL_PRICE_ID=price_...

# ── PayPal ────────────────────────────────────────────────────────────────────
# Get from: https://developer.paypal.com → Apps & Credentials
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
BILLCRAFT_PAYPAL_API_URL=https://api-m.paypal.com
BILLCRAFT_PAYPAL_CLIENT_ID=
BILLCRAFT_PAYPAL_CLIENT_SECRET=
BILLCRAFT_PAYPAL_WEBHOOK_ID=
BILLCRAFT_PAYPAL_BASIC_MONTHLY_PLAN_ID=P-...
BILLCRAFT_PAYPAL_BASIC_ANNUAL_PLAN_ID=P-...
BILLCRAFT_PAYPAL_PRO_MONTHLY_PLAN_ID=P-...
BILLCRAFT_PAYPAL_PRO_ANNUAL_PLAN_ID=P-...
BILLCRAFT_PAYPAL_AGENCY_MONTHLY_PLAN_ID=P-...
BILLCRAFT_PAYPAL_AGENCY_ANNUAL_PLAN_ID=P-...

# ── Google OAuth (Sign-In) ────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_AUTH_FLOW=custom   → account chooser shows this app's own domain (default)
# GOOGLE_AUTH_FLOW=supabase → delegates to the Supabase dashboard's configured provider
BILLCRAFT_GOOGLE_AUTH_FLOW=custom
BILLCRAFT_GOOGLE_CLIENT_ID=
BILLCRAFT_GOOGLE_CLIENT_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────────
# Random 32-char secret: openssl rand -hex 32
BILLCRAFT_PORTAL_SESSION_SECRET=
BILLCRAFT_CRON_SECRET=
# Comma-separated emails allowed into /admin
BILLCRAFT_ADMIN_EMAILS=


# ═════════════════════════════════════════════════════════════════════════════
# SupportCraft AI
# Docs: https://supportcraft.aakasa.dev
# ═════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPPORTCRAFT_SUPABASE_URL=https://<project-ref>.supabase.co
SUPPORTCRAFT_SUPABASE_ANON_KEY=
SUPPORTCRAFT_SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
SUPPORTCRAFT_APP_URL=https://supportcraft.aakasa.dev

# ── AI provider ───────────────────────────────────────────────────────────────
# Set to "openai" or "anthropic"
SUPPORTCRAFT_AI_PROVIDER=openai
SUPPORTCRAFT_OPENAI_API_KEY=sk-...
SUPPORTCRAFT_ANTHROPIC_API_KEY=sk-ant-...

# ── Email ─────────────────────────────────────────────────────────────────────
# Set to "resend" or "gmail"
SUPPORTCRAFT_EMAIL_PROVIDER=resend
SUPPORTCRAFT_SENDING_DOMAIN=supportcraft.aakasa.dev
SUPPORTCRAFT_EMAIL_FROM=support@aakasa.dev

# Gmail OAuth2 (only required when EMAIL_PROVIDER=gmail)
SUPPORTCRAFT_GMAIL_CLIENT_ID=
SUPPORTCRAFT_GMAIL_CLIENT_SECRET=
SUPPORTCRAFT_GMAIL_REFRESH_TOKEN=

# Resend (only required when EMAIL_PROVIDER=resend)
SUPPORTCRAFT_RESEND_API_KEY=re_...
SUPPORTCRAFT_RESEND_FROM_EMAIL=support@aakasa.dev
SUPPORTCRAFT_RESEND_FROM_NAME=SupportCraft AI

# ── Inbound email webhook ─────────────────────────────────────────────────────
# Shared secret verifying inbound-email webhook calls (see workers/email-inbound)
SUPPORTCRAFT_INBOUND_SECRET=

# ── PayPal ────────────────────────────────────────────────────────────────────
SUPPORTCRAFT_PAYPAL_API_URL=https://api-m.paypal.com
SUPPORTCRAFT_PAYPAL_CLIENT_ID=
SUPPORTCRAFT_PAYPAL_CLIENT_SECRET=
SUPPORTCRAFT_PAYPAL_WEBHOOK_ID=
# Client-side (NEXT_PUBLIC_*) plan IDs baked into the PayPal subscribe buttons
SUPPORTCRAFT_PAYPAL_PLAN_ID_PUBLIC_FREELANCER_MONTHLY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PUBLIC_PRO=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PUBLIC_BUSINESS=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PUBLIC_AGENCY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PUBLIC_FREELANCER_YEARLY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PUBLIC_PRO_YEARLY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PUBLIC_BUSINESS_YEARLY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PUBLIC_AGENCY_YEARLY=P-...
# Server-side plan IDs (used by the webhook to map a subscription -> DB plan —
# note this can be a genuinely different PayPal plan ID than the matching
# NEXT_PUBLIC_* one above, not a duplicate)
SUPPORTCRAFT_PAYPAL_PLAN_ID_FREELANCER_MONTHLY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PRO=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_BUSINESS=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_AGENCY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_FREELANCER_YEARLY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_PRO_YEARLY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_BUSINESS_YEARLY=P-...
SUPPORTCRAFT_PAYPAL_PLAN_ID_AGENCY_YEARLY=P-...

# ── Google OAuth (Sign-In) ────────────────────────────────────────────────────
SUPPORTCRAFT_GOOGLE_CLIENT_ID=
SUPPORTCRAFT_GOOGLE_CLIENT_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────────
SUPPORTCRAFT_CRON_SECRET=
# Comma-separated emails allowed into /admin
SUPPORTCRAFT_ADMIN_EMAILS=


# ═════════════════════════════════════════════════════════════════════════════
# TaskCraft AI
# Docs: https://taskcraft.aakasa.dev
# ═════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
TASKCRAFT_SUPABASE_URL=https://<project-ref>.supabase.co
TASKCRAFT_SUPABASE_ANON_KEY=
TASKCRAFT_SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
TASKCRAFT_APP_URL=https://taskcraft.aakasa.dev

# ── OpenAI ────────────────────────────────────────────────────────────────────
TASKCRAFT_OPENAI_API_KEY=sk-...

# ── PayPal ────────────────────────────────────────────────────────────────────
# Same value used for both the NEXT_PUBLIC_* build arg and the server-side var
# in this app (unlike SupportCraft, which uses two distinct sets of plan IDs)
TASKCRAFT_PAYPAL_API_URL=https://api-m.paypal.com
TASKCRAFT_PAYPAL_CLIENT_ID=
TASKCRAFT_PAYPAL_CLIENT_SECRET=
TASKCRAFT_PAYPAL_WEBHOOK_ID=
TASKCRAFT_PAYPAL_PLAN_ID_SOLO_MONTHLY=P-...
TASKCRAFT_PAYPAL_PLAN_ID_SOLO_YEARLY=P-...
TASKCRAFT_PAYPAL_PLAN_ID_TEAM_MONTHLY=P-...
TASKCRAFT_PAYPAL_PLAN_ID_TEAM_YEARLY=P-...

# ── Google OAuth (Sign-In) ────────────────────────────────────────────────────
TASKCRAFT_GOOGLE_AUTH_FLOW=custom
TASKCRAFT_GOOGLE_CLIENT_ID=
TASKCRAFT_GOOGLE_CLIENT_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
TASKCRAFT_RESEND_API_KEY=re_...
TASKCRAFT_RESEND_FROM_EMAIL=taskcraft@aakasa.dev
TASKCRAFT_RESEND_FROM_NAME=TaskCraft AI

# ── Misc ──────────────────────────────────────────────────────────────────────
TASKCRAFT_CRON_SECRET=
# Comma-separated emails allowed into /admin
TASKCRAFT_ADMIN_EMAILS=

# Note: BILLCRAFT_INTERNAL_URL / SUPPORTCRAFT_INTERNAL_URL (container-to-
# container URLs TaskCraft uses to call BillCraft/SupportCraft directly,
# bypassing nginx) are not secrets and stay as literals in docker-compose.yml.


# ═════════════════════════════════════════════════════════════════════════════
# PDFCraft
# Docs: https://pdfcraft.aakasa.dev
# ═════════════════════════════════════════════════════════════════════════════
# Entirely client-side PDF processing — no database, no secrets. Only the
# canonical app URL is needed, for metadata/OG tags.
PDFCRAFT_APP_URL=https://pdfcraft.aakasa.dev


# ═════════════════════════════════════════════════════════════════════════════
# MeetingCraft
# Docs: https://meetingcraft.aakasa.dev
# ═════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project → Settings → API
MEETINGCRAFT_SUPABASE_URL=https://<project-ref>.supabase.co
MEETINGCRAFT_SUPABASE_ANON_KEY=
MEETINGCRAFT_SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
MEETINGCRAFT_APP_URL=https://meetingcraft.aakasa.dev

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → your database → Connect → ioredis.
# Must be rediss:// (TLS) — Upstash requires it.
MEETINGCRAFT_REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ── AWS KMS (envelope-encrypts OAuth refresh tokens) ──────────────────────────
# IAM principal needs kms:GenerateDataKey + kms:Decrypt on this one CMK only.
MEETINGCRAFT_AWS_REGION=us-east-1
MEETINGCRAFT_AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:...:key/...
MEETINGCRAFT_AWS_ACCESS_KEY_ID=
MEETINGCRAFT_AWS_SECRET_ACCESS_KEY=

# ── Google Calendar OAuth2 ─────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: MEETINGCRAFT_APP_URL + /api/integrations/google-calendar/callback
MEETINGCRAFT_GOOGLE_OAUTH_CLIENT_ID=
MEETINGCRAFT_GOOGLE_OAUTH_CLIENT_SECRET=
# HMAC secret signing Google Calendar push-notification webhook calls: openssl rand -hex 32
MEETINGCRAFT_GOOGLE_CALENDAR_WEBHOOK_SECRET=

# ── Google Sign-In (separate OAuth client from Calendar above) ───────────────
# Redirect URI: MEETINGCRAFT_APP_URL + /auth/google/callback
MEETINGCRAFT_GOOGLE_LOGIN_CLIENT_ID=
MEETINGCRAFT_GOOGLE_LOGIN_CLIENT_SECRET=

# ── Zoom OAuth2 (User-managed app, not Server-to-Server) ──────────────────────
# Get from: https://marketplace.zoom.us
# Redirect URI: MEETINGCRAFT_APP_URL + /api/integrations/zoom/callback
MEETINGCRAFT_ZOOM_OAUTH_CLIENT_ID=
MEETINGCRAFT_ZOOM_OAUTH_CLIENT_SECRET=

# ── Microsoft Teams OAuth2 (delegated, via Microsoft Entra ID) ────────────────
# Redirect URI: MEETINGCRAFT_APP_URL + /api/integrations/teams/callback
# TENANT_ID: "common" accepts work/school + personal accounts; pin to a GUID
# (or "organizations") to restrict to one org.
MEETINGCRAFT_MS_TEAMS_OAUTH_CLIENT_ID=
MEETINGCRAFT_MS_TEAMS_OAUTH_CLIENT_SECRET=
MEETINGCRAFT_MS_TEAMS_OAUTH_TENANT_ID=common

# ── Misc ──────────────────────────────────────────────────────────────────────
# HMAC secret signing guest booking-management links: openssl rand -hex 32
MEETINGCRAFT_BOOKING_GUEST_TOKEN_SECRET=
# Bearer token for cron-triggered endpoints (watch renewal, stale-booking cleanup): openssl rand -hex 32
MEETINGCRAFT_CRON_SECRET=
# Comma-separated emails allowed into /admin
MEETINGCRAFT_ADMIN_EMAILS=
# PayPal billing isn't built yet — leave false
MEETINGCRAFT_FEATURE_BILLING_ENABLED=false

# ── Email (worker only — reminders, no-show/feedback prompts) ────────────────
MEETINGCRAFT_RESEND_API_KEY=re_...
MEETINGCRAFT_RESEND_FROM_EMAIL=bookings@notify.meetingcraft.aakasa.dev
MEETINGCRAFT_RESEND_FROM_NAME=MeetingCraft
# Comma-separated minutes-before-start for reminder emails
MEETINGCRAFT_REMINDER_MINUTES_BEFORE=1440,60
# Minutes after meeting end before the no-show/feedback prompt fires
MEETINGCRAFT_NO_SHOW_FEEDBACK_DELAY_MINUTES=60
